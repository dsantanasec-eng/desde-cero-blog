:root{
  --bg:#0f1115; --fg:#fff; --ink:#1f2328; --muted:#667085;
  --line:#e6e7eb; --card:#fff; --brand:#5b8cff; --brand-ink:#1f3a7a;
}

*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,system-ui,sans-serif;
  color:var(--ink); background:#f7f8fb;
}

/* Header */
.site-header{background:var(--bg); color:var(--fg); border-bottom:1px solid #161922}
.nav{max-width:1040px;margin:0 auto;padding:14px 16px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand a{color:#fff;text-decoration:none;font-weight:700;font-size:1.05rem}
.menu a{color:#fff;text-decoration:none;opacity:.9;margin-left:14px}
.menu a:hover{opacity:1;text-decoration:underline}

/* Layout */
.container{max-width:1040px;margin:0 auto;padding:0 16px}
.hero{padding:42px 0 26px}
.hero h1{margin:0 0 8px}
.hero p{margin:0;color:var(--muted)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
@media (max-width:860px){.grid{grid-template-columns:1fr}}

/* Card */
.card{
  background:var(--card); border:1px solid var(--line);
  border-radius:12px; padding:18px;
  box-shadow:0 1px 0 rgba(10,10,10,0.02);
}
.card .muted{color:var(--muted)}

/* Buttons & tags */
.btn{
  display:inline-block; border:1px solid var(--ink); border-radius:10px;
  padding:9px 12px; text-decoration:none; color:var(--ink); font-weight:500;
}
.btn:hover{background:var(--ink); color:#fff}
.btn-brand{border-color:var(--brand); color:#fff; background:var(--brand)}
.btn-brand:hover{background:var(--brand-ink); border-color:var(--brand-ink)}
.tag{
  display:inline-block; background:#eef3ff; border:1px solid #dbe6ff;
  color:#243b77; border-radius:999px; padding:2px 8px; margin-right:6px; font-size:.8rem
}

/* Footer */
.site-footer{border-top:1px solid var(--line); margin-top:36px}
.site-footer .inner{max-width:1040px;margin:0 auto;padding:14px 16px;color:var(--muted);font-size:.95rem}

/* Hero highlight */
.hero-highlight{
  background:linear-gradient(135deg, rgba(91,140,255,.18), rgba(91,140,255,.06));
  border:1px solid #dbe6ff; border-radius:12px; padding:16px; margin-top:16px;
}

/* Lists */
ul.clean{list-style:none;padding-left:0;margin:0}
ul.clean li{padding:8px 0;border-top:1px solid var(--line)}
ul.clean li:first-child{border-top:none}